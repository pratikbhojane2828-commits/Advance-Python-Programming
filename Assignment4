def fibonacci(n, memo):

    # Base cases
    if n == 0:
        return 0

    if n == 1:
        return 1

    # Check if value is already calculated
    if n in memo:
        return memo[n]

    # Calculate and store the result
    memo[n] = fibonacci(n - 1, memo) + fibonacci(n - 2, memo)

    return memo[n]


n = int(input("Enter n: "))

memo = {}

result = fibonacci(n, memo)

print("Fibonacci number:", result)

def fibonacci(n):
    # Create DP table
    dp = [0] * (n + 1)
# Base case
    if n >= 1:
        dp[1] = 1
    # Fill the table
    for i in range(2, n + 1):
        dp[i] = dp[i - 1] + dp[i - 2]
    return dp[n]
n = int(input("Enter n: "))
result = fibonacci(n)
print("Fibonacci number:", result)
